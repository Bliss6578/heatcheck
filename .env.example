# Application and managed authentication
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# FortyGuard (server-side only; never prefix the key with VITE_)
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com
FORTYGUARD_ENABLED=true
FORTYGUARD_MAX_POLL_ATTEMPTS=40
FORTYGUARD_POLL_INTERVAL_MS=3000

# HeatCheck operating modes
HEATCHECK_MOCK_MODE=false
HEATCHECK_ALLOW_MOCK_FALLBACK=false
HEATCHECK_CACHE_TTL_SECONDS=600
HEATCHECK_AGENT_ENABLED=true
HEATCHECK_AGENT_MAX_STEPS=8
HEATCHECK_AGENT_MAX_TOOL_CALLS=12

# GroqCloud planner (server-side only)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Optional narration. The deterministic agent works without these.
OPENAI_API_KEY=
OPENAI_MODEL=

# Production scheduling and API protection
CRON_SECRET=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=120
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Managed alert delivery (all optional, server-side only)
HEATCHECK_ALERT_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_FROM=HeatCheck <alerts@example.com>
ALERT_EMAIL_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=

# Optional external error collector webhook
OBSERVABILITY_WEBHOOK_URL=
